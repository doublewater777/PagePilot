# ==========================================
# Xcode
# ==========================================

# Generated project files (managed by XcodeGen)
*.xcodeproj
*.xcworkspace
*.xctestplan

# Build artifacts
build/
build_derived/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip

# User-specific Xcode settings
xcuserdata/
*.xcscmblueprint

# Obj-C / Swift
*.hmap
*.o
*.d

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# ==========================================
# Swift Package Manager
# ==========================================

.build/
.swiftpm/
Package.resolved

# ==========================================
# CocoaPods (legacy, kept for safety)
# ==========================================

Pods/
Podfile.lock

# ==========================================
# Carthage (legacy, kept for safety)
# ==========================================

Carthage/Build/
Cartfile.resolved

# ==========================================
# Signing & Secrets
# ==========================================

*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest

# ==========================================
# Project-specific ignores
# ==========================================

# XcodeGen source (generated from project.yml)
/project.yml

# Local-only integrations (secrets, personal config)
Integrations/Local/

# asc CLI workspace (tokens, caches, local state)
.asc/

# gstack workspace
.gstack/

# App Store Connect export options for distribution (has signing identity)
ExportOptionsExport.plist

# Design demos (large binary assets, not source)
design-demos/

# Kiro AI workspace
.kiro/

# ==========================================
# macOS
# ==========================================

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==========================================
# Editors
# ==========================================

# VSCode
.vscode/

# JetBrains / AppCode
.idea/
*.iws
out/

# ==========================================
# Python (scripts/)
# ==========================================

__pycache__/
*.pyc
*.pyo
.venv*/
.venv-shots/

# ==========================================
# Misc
# ==========================================

*.log